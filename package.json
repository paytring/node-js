{
  "name": "@paytring/nodejs-sdk",
  "type": "module",
  "version": "1.4.0",
  "description": "Official Node.js SDK for Paytring Payment Gateway - Accept payments, validate UPI addresses, and manage orders with ES modules support",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./index.d.ts"
    }
  },
