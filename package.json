    "lint": "echo \"Add linting here\"",
    "build": "echo \"No build step required for ES modules\""
  },
  "keywords": [
    "paytring",
    "payment",
    "gateway",
    "upi",
    "nodejs",
    "sdk",
    "payments",
    "india",
    "fintech",
    "transaction",
    "esm",
    "es-modules",
    "import"
  ],
  "author": "Paytring",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paytring/nodejs-sdk"
  },
  "homepage": "https://paytring.com",
  "bugs": {
    "url": "https://github.com/paytring/nodejs-sdk/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "src/",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "axios": "^1.7.2"
  },
  "devDependencies": {
